## Textes longs (missions, dialogues) enregistrés par les modules de données.
var extra := {"fr": {}, "en": {}}


func t(key: String, args: Array = []) -> String:
	var table: Dictionary = STRINGS.get(lang, STRINGS["fr"])
	var s: String = ""
	if table.has(key):
		s = table[key]
	elif extra.get(lang, {}).has(key):
		s = extra[lang][key]
	elif STRINGS["fr"].has(key):
		s = STRINGS["fr"][key]
	elif extra["fr"].has(key):
		s = extra["fr"][key]
	else:
		s = key
	for i in args.size():
		s = s.replace("{%d}" % i, str(args[i]))
	return s


func register(lang_code: String, entries: Dictionary) -> void:
	if not extra.has(lang_code):
		extra[lang_code] = {}
	extra[lang_code].merge(entries, true)


func set_language(code: String) -> void:
	if code != "fr" and code != "en":
		code = "fr"
	if code == lang:
		return
	lang = code
	Events.language_changed.emit()


## Vitesse affichée : km/h en français, mph en anglais.
func speed_value(mps: float) -> int:
	if lang == "en":
		return int(round(absf(mps) * 2.23694))
	return int(round(absf(mps) * 3.6))
