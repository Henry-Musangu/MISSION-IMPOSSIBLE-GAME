; Engine configuration file.
; New York Life — Open World (Godot 4.5, rendu Compatibility pour Android)

config_version=5

[application]

config/name="New York Life"
config/description="Monde ouvert 3D à New York"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Events="*res://scripts/core/events.gd"
Loc="*res://scripts/core/loc.gd"
Settings="*res://scripts/core/settings.gd"
GameState="*res://scripts/core/game_state.gd"
InputState="*res://scripts/core/input_state.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
